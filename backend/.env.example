# =============================================================================
# EcoRuta API · variables de entorno
# Copia este archivo como .env (nunca subas .env al repositorio, RNF-14).
# En Render se capturan en: Service > Environment.
# =============================================================================

NODE_ENV=development
PORT=3000

# --- Neon (Dashboard > Connect) ----------------------------------------------
# App: cadena POOLED (el host incluye "-pooler")
DATABASE_URL=postgresql://USUARIO:CONTRASENA@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Migraciones: cadena DIRECTA (mismo host SIN "-pooler")
DATABASE_URL_DIRECT=postgresql://USUARIO:CONTRASENA@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
PG_POOL_MAX=10

# --- Sesión (RNF-06) ------------------------------------------------------------
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# URL pública de ESTA API (se usa en los enlaces de los correos).
# Local con el celular: http://<IP-de-tu-PC>:3000   ·   Render: https://ecoruta-api.onrender.com
PUBLIC_API_URL=http://localhost:3000

# Orígenes permitidos para Expo Web (la app móvil no necesita CORS). Separados por coma.
CORS_ORIGINS=http://localhost:8081

# --- Correo (RF-02, RF-04) --------------------------------------------------------
# console = imprime el correo y el enlace en la terminal (desarrollo)
# smtp    = envío real (Gmail con contraseña de aplicación, Brevo, Mailtrap…)
MAIL_DRIVER=console
MAIL_FROM="EcoRuta Escolar <no-reply@ecoruta.app>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# --- Documentos de registro (retícula / horario) ---------------------------------
# local      = carpeta ./uploads (solo desarrollo; el disco de Render se borra en cada deploy)
# cloudinary = almacenamiento privado gratuito (cloudinary.com > Dashboard > API Keys)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
