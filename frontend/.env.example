# Copia como .env y reinicia Expo con:  npx expo start -c
# URL de la API (sin "/" al final):
#   Celular con Expo Go (misma Wi-Fi que tu PC): http://<IP de tu PC>:3000   (ipconfig → "Dirección IPv4")
#   Emulador de Android:                        http://10.0.2.2:3000
#   Expo Web en la misma PC:                    http://localhost:3000
#   Producción (Render):                        https://ecoruta-api.onrender.com
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
